      "formula": "-(C_adj[t]/C_adj[t-5]-1)"
    },
    "reversal1": {
      "name": "1日反转",
      "formula": "-r_adj[t]"
    },
    "momentum20": {
      "name": "20日动量",
      "formula": "C_adj[t]/C_adj[t-20]-1"
    },
    "momentum60": {
      "name": "60日动量跳过5日",
      "formula": "C_adj[t-5]/C_adj[t-65]-1"
    },
    "lowvol20": {
      "name": "20日低波动",
      "formula": "-std(r_adj[t-19:t],ddof=1)"
    },
    "liquidity20": {
