{
  "format": "daily-factor-strategy",
  "version": 1,
  "name": "20日低波动",
  "score": {"op": "negate", "args": [
    {"op": "rolling_std", "args": [{"op": "daily_return"}], "params": {"window": 20}}
  ]},
  "filter": {"op": "and", "args": [
    {"op": "greater_equal", "args": [{"op": "raw_close"}, {"op": "constant", "params": {"value": 2}}]},
    {"op": "is_finite", "args": [{"op": "daily_return"}]}
  ]},
  "selection": {"top_n": 100, "rebalance": "weekly", "direction": "desc"},
  "packs": []
}
